{
  "name": "saveprep-node",
  "version": "2.4.0",
  "description": "Prepare OpenRCT2 saves for use with FFA Tycoon multiplayer servers",
  "keywords": [
    "openrct2",
    "Rollercoaster Tycoon"
  ],
  "bugs": {
    "url": "https://gitlab.com/sanin.dev/ffa-tycoon-scenario-prep/-/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/sanin.dev/ffa-tycoon-scenario-prep.git"
  },
  "license": "GPL-3.0",
  "author": "Cory Sanin",
  "type": "module",
  "main": "./distribution/server/index.js",
  "scripts": {
    "build": "tsc && SCRIPTINDIR=distribution/client/ build-shit",
    "watch": "tsc && SCRIPTINDIR=distribution/client/ build-shit --watch",
    "start": "node distribution/server/index.js"
  },
  "dependencies": {
    "dayjs": "1.11.23",
    "ejs": "7.0.2",
    "express": "5.3.0",
    "express-fileupload": "1.5.2",
    "spawn-but-with-promises": "^1.0.4"
  },
  "devDependencies": {
    "@sindresorhus/tsconfig": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/express-fileupload": "^1.5.1",
    "@types/node": "^26.6.6",
    "forking-build-shit": "1.1.9",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
